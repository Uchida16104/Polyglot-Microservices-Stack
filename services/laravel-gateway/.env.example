APP_NAME=PolyglotGateway
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-gateway.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=your-cluster.crdb.io
DB_PORT=26257
DB_DATABASE=polyglot
DB_USERNAME=polyglot_user
DB_PASSWORD=
DB_SSLMODE=verify-full

CACHE_DRIVER=redis
SESSION_DRIVER=redis

REDIS_HOST=your-redis.render.com
REDIS_PASSWORD=
REDIS_PORT=6379

RUST_CORE_URL=http://rust-core:8001
CSHARP_BUSINESS_URL=http://csharp-business:8002
PYTHON_ML_URL=http://python-ml:8003
RESEARCH_RUNTIMES_URL=http://research-runtimes:8004
